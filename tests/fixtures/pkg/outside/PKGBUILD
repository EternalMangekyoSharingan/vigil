# SYNTHETIC test fixture for Vigil Pkg: writes where a build must not. Inert text.
# Maintainer: Frank Example <frank at example dot org>
pkgname=outside-demo
pkgver=3.1
pkgrel=2
pkgdesc="Writes outside the package (test fixture)"
arch=('x86_64')
url="https://outside.example.org"
license=('MIT')
source=("https://outside.example.org/outside-demo-$pkgver.tar.gz")
sha256sums=('2a5b6c7d8e9f0a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f6071829a')

package() {
  install -Dm755 outside-demo /usr/bin/outside-demo
  sudo cp outside-demo.conf /etc/outside-demo.conf
  echo 'export PATH=$HOME/.outside:$PATH' >> ~/.bashrc
  mkdir -p "$HOME/.config/systemd/user"
  cp outside.service "$HOME/.config/systemd/user/outside.service"
  systemctl --user enable outside.service
  install -Dm755 outside-demo "$pkgdir/usr/bin/outside-demo"
}
